* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.npz binary
*.npy binary
*.png binary
# Frozen scientific inputs are fingerprinted as exact bytes.
data/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# The exploratory extension has its own exact-byte input/source manifest.
experiments/frontier/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
